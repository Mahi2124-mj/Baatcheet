# Baatcheet configuration. Copy to .env and fill in. NEVER commit the real .env.
# The API checks these on start and stops with a clear message if something required is missing.

# ---- Core ----
NODE_ENV=development
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgresql://baatcheet:CHANGE_ME_DB_PASSWORD@postgres:5432/baatcheet
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# Long random string (at least 32 characters): openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_DAYS=30
# Public URL of the site (links in e-mails, allowed browser origin)
APP_URL=http://localhost:8080
# Public URL where /api and /files are served (same as APP_URL behind the bundled Caddy proxy)
API_URL=http://localhost:8080
# Header with the visitor's IP when the API is only reachable through a tunnel (home mode: cf-connecting-ip)
CLIENT_IP_HEADER=
# Extra allowed origins, comma separated (optional)
CORS_ORIGINS=
# Proxies in front of the API: true (one, e.g. Caddy), 2 behind Cloudflare Tunnel + Caddy, false for none
TRUST_PROXY=true
# E-mails that get the ADMIN role
ADMIN_EMAILS=admin@example.com
# Usernames that get the ADMIN role (accounts made without an e-mail); applied on start if they exist
ADMIN_USERNAMES=
LOG_LEVEL=info

# ---- File storage ----
# local = a Docker volume on this server (default). s3 = any S3-compatible store (AWS S3, Cloudflare R2,
# Backblaze B2, or the bundled MinIO: docker compose --profile s3 up). The API creates the bucket if missing.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=/data/uploads
S3_ENDPOINT=http://minio:9000
# Address the BROWSER uses to reach the bucket (signed upload/download URLs)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=baatcheet
S3_ACCESS_KEY_ID=baatcheet
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET
S3_FORCE_PATH_STYLE=true

# ---- Calls: STUN / TURN ----
STUN_URLS=stun:stun.l.google.com:19302
# Your coturn server(s). Use turns: (TLS, port 5349) in production so calls work on strict networks.
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# Must equal coturn's static-auth-secret. openssl rand -hex 32
TURN_SECRET=CHANGE_ME_TURN_SECRET
# Or a hosted TURN service with a fixed login (e.g. Metered) instead of TURN_SECRET:
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TTL_SECONDS=3600
CALL_RING_SECONDS=45

# ---- Group calls (LiveKit SFU, optional) ----
# The bundled dev LiveKit uses devkey / secret. Generate real keys for production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- E-mail (verification + password reset) ----
# Development: Mailpit catches everything at http://localhost:8025
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Baatcheet <no-reply@example.com>

# ---- Browser push notifications (optional) ----
# Generate with: npm run vapid -w server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Web app ----
# Where the Next.js server reaches the API for /api rewrites (not needed behind Caddy)
API_INTERNAL_URL=http://server:4000
# Socket.IO URL for the browser; empty = same origin (Caddy proxies /socket.io)
NEXT_PUBLIC_SOCKET_URL=
